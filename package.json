{
  "name": "@aeroscis/dsh-workspace-manager",
  "version": "0.4.0",
  "description": "Workspace order, cleanup and path relocation for DeepSeek Harness: auto-rise the active workspace, pin, one-click sort, remove empty workspaces, relocate a workspace's folder with its conversations carried over. 工作区管理：活动项目自动上浮、置顶、一键整理、清理空工作区、工作区路径迁移（可连文件夹与对话一起搬）。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "workspace",
    "workspace-manager",
    "sidebar"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "Aeroscis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aeroscis/dsh-workspace-manager.git"
  },
  "homepage": "https://github.com/Aeroscis/dsh-workspace-manager#readme",
  "bugs": {
    "url": "https://github.com/Aeroscis/dsh-workspace-manager/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "^0.2.1-rc.3"
  },
  "scripts": {
    "test": "node test/activity.test.mjs && node test/sort-rule.test.mjs && node test/drag-geometry.test.mjs && node test/relocate.test.mjs",
    "check": "node scripts/check-release.mjs && npm test && npm pack --dry-run"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
